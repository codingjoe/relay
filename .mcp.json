{
  "mcpServers": {
    "dozzle": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "http://127.0.0.1:5000/api/mcp"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--output-dir=.playwright-mcp"
      ],
      "command": "npx",
      "tools": [
        "*"
      ],
      "type": "local"
    }
  }
}
