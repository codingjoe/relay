{
  "mcpServers": {
    "cloudfleet": {
      "args": [
        "mcp"
      ],
      "command": "cloudfleet",
      "type": "local"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--output-dir=.playwright-mcp"
      ],
      "command": "npx",
      "tools": [
        "*"
      ],
      "type": "local"
    }
  }
}
