#cloud-config
#
# Rendered by deploy/steps/05-server.sh with envsubst, which fills in the deploy
# key, the netplan address list, the k3s flags and the namespace.
users:
  - default
  - name: github
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${DEPLOY_PUBLIC_KEY}
  - name: collaborator
    shell: /bin/rbash
    homedir: /home/collaborator
write_files:
  # netplan hands the egress pool to systemd-networkd, which re-applies it
  # whenever it reconfigures eth0 and after every reboot. An address bound by
  # hand belongs to no configuration: networkd drops it on the next
  # reconfiguration, which is how unattended-upgrades restarting networkd
  # emptied the pool.
  - path: /etc/netplan/60-floating-ip.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        renderer: networkd
        ethernets:
          eth0:
            addresses: [${NETPLAN_ADDRESSES}]
  - path: /etc/relay/bootstrap.yaml
    permissions: "0600"
    content: |
      apiVersion: v1
      kind: Namespace
      metadata:
        name: ${RELAY_NAMESPACE}
        labels:
          app.kubernetes.io/part-of: relay
      ---
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: deploy
        namespace: ${RELAY_NAMESPACE}
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: Role
      metadata:
        name: deploy
        namespace: ${RELAY_NAMESPACE}
      rules:
        # The groups the kustomization applies. Creating pods is inside this
        # grant, and that reaches node root: no Pod Security Admission level is
        # enforced here, because baseline forbids hostNetwork and caddy, dnsdist
        # and sender need it. An enforcing policy has to exempt those three.
        - apiGroups: ["", "apps", "batch"]
          resources: ["*"]
          verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: RoleBinding
      metadata:
        name: deploy
        namespace: ${RELAY_NAMESPACE}
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: Role
        name: deploy
      subjects:
        - kind: ServiceAccount
          name: deploy
          namespace: ${RELAY_NAMESPACE}
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: deploy-token
        namespace: ${RELAY_NAMESPACE}
        annotations:
          kubernetes.io/service-account.name: deploy
      type: kubernetes.io/service-account-token
      ---
      # Dozzle watches every namespace, so discovery needs cluster scope.
      # Restart and shell stay in the namespace. The deploy token cannot
      # grant cluster scope, so the boot applies these with the admin
      # kubeconfig.
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: dozzle
      rules:
        - apiGroups: [""]
          resources: ["pods", "pods/log", "nodes"]
          verbs: ["get", "list", "watch"]
        - apiGroups: ["apps"]
          resources: ["deployments", "replicasets", "daemonsets", "statefulsets"]
          verbs: ["get"]
        - apiGroups: ["batch"]
          resources: ["jobs", "cronjobs"]
          verbs: ["get"]
        - apiGroups: ["metrics.k8s.io"]
          resources: ["pods"]
          verbs: ["get", "list"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: dozzle
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: dozzle
      subjects:
        - kind: ServiceAccount
          name: dozzle
          namespace: ${RELAY_NAMESPACE}
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: Role
      metadata:
        name: dozzle
        namespace: ${RELAY_NAMESPACE}
      rules:
        - apiGroups: [""]
          resources: ["pods"]
          verbs: ["delete"]
        - apiGroups: [""]
          resources: ["pods/exec", "pods/attach"]
          verbs: ["create"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: RoleBinding
      metadata:
        name: dozzle
        namespace: ${RELAY_NAMESPACE}
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: Role
        name: dozzle
      subjects:
        - kind: ServiceAccount
          name: dozzle
          namespace: ${RELAY_NAMESPACE}
  - path: /usr/local/bin/relay-bootstrap.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu

      systemctl disable --now systemd-resolved
      rm -f /etc/resolv.conf
      printf 'nameserver 1.1.1.1\nnameserver 9.9.9.9\n' > /etc/resolv.conf

      netplan apply

      # netplan apply restarts networkd, and the DHCP lease that gives the
      # default route its source address returns a moment later. Reading the
      # route once races that, finds no source, and aborts before k3s installs.
      primary_ip=""
      attempt=0
      while [ -z "$primary_ip" ] && [ "$attempt" -lt 60 ]; do
          primary_ip="$(ip -4 route show default | awk '{for (i = 1; i <= NF; i++) if ($i == "src") {print $(i+1); exit}}')"
          attempt=$((attempt + 1))
          [ -n "$primary_ip" ] || sleep 1
      done
      if [ -z "$primary_ip" ]; then
          echo "no default route with a source address after 60s" >&2
          exit 1
      fi

      curl -sfL https://get.k3s.io | \
          INSTALL_K3S_EXEC="${K3S_INSTALL_FLAGS} --node-ip=$primary_ip" sh -

      until k3s kubectl apply -f /etc/relay/bootstrap.yaml >/dev/null 2>&1; do
          sleep 5
      done
runcmd:
  - /usr/local/bin/relay-bootstrap.sh
