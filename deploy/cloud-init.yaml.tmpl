#cloud-config
#
# Rendered by deploy/steps/05-server.sh with envsubst, which replaces the deploy
users:
  - default
  - name: github
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${DEPLOY_PUBLIC_KEY}
  - name: collaborator
    shell: /bin/rbash
    home: /home/collaborator
write_files:
  # netplan hands the egress pool to systemd-networkd, which re-applies it
  # whenever it reconfigures eth0 and after every reboot. An address bound by
  # hand belongs to no configuration: networkd drops it on the next
  # reconfiguration, which is how unattended-upgrades restarting networkd
  # emptied the pool.
  - path: /etc/netplan/60-floating-ip.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        renderer: networkd
        ethernets:
          eth0:
            addresses: [${NETPLAN_ADDRESSES}]
  - path: /etc/relay/bootstrap.yaml
    permissions: "0600"
    content: |
      apiVersion: v1
      kind: Namespace
      metadata:
        name: ${RELAY_NAMESPACE}
        labels:
          app.kubernetes.io/part-of: relay
      ---
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        name: deploy
        namespace: ${RELAY_NAMESPACE}
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: Role
      metadata:
        name: deploy
        namespace: ${RELAY_NAMESPACE}
      rules:
        - apiGroups: ["", "apps", "batch", "policy", "networking.k8s.io"]
          resources: ["*"]
          verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
      ---
      apiVersion: rbac.authorization.k8s.io/v1
      kind: RoleBinding
      metadata:
        name: deploy
        namespace: ${RELAY_NAMESPACE}
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: Role
        name: deploy
      subjects:
        - kind: ServiceAccount
          name: deploy
          namespace: ${RELAY_NAMESPACE}
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: deploy-token
        namespace: ${RELAY_NAMESPACE}
        annotations:
          kubernetes.io/service-account.name: deploy
      type: kubernetes.io/service-account-token
  - path: /usr/local/bin/relay-bootstrap.sh
    permissions: "0755"
    content: |
      set -eu

      systemctl disable --now systemd-resolved
      rm -f /etc/resolv.conf
      printf 'nameserver 1.1.1.1\nnameserver 9.9.9.9\n' > /etc/resolv.conf

      netplan apply

      primary_ip="$(ip -4 route show default | awk '{for (i = 1; i <= NF; i++) if ($i == "src") {print $(i+1); exit}}')"
      [ -n "$primary_ip" ] || { echo "could not determine the primary address" >&2; exit 1; }

      curl -sfL https://get.k3s.io | \
          INSTALL_K3S_EXEC="${K3S_INSTALL_FLAGS} --node-ip=$primary_ip" sh -

      until k3s kubectl apply -f /etc/relay/bootstrap.yaml >/dev/null 2>&1; do
          sleep 5
      done
runcmd:
  - /usr/local/bin/relay-bootstrap.sh
