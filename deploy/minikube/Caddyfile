{
	admin off

	log {
		output stdout
		format json
	}

	# No public address for an ACME challenge, so every certificate comes from
	# Caddy's own CA.
	local_certs

	layer4 {
		:587 {
			route {
				proxy msa:587 {
					proxy_protocol v2
				}
			}
		}
		:465 {
			route {
				tls
				proxy msa:2465 {
					proxy_protocol v2
				}
			}
		}
		:25 {
			route {
				proxy mta:25 {
					proxy_protocol v2
				}
			}
		}
	}
}

{$HOSTNAME} {
	reverse_proxy web:8000
}

smtp.{$HOSTNAME} {
	respond "OK" 200
}

mx1.{$HOSTNAME} {
	respond "OK" 200
}

mx2.{$HOSTNAME} {
	respond "OK" 200
}

{$RELAY_STORAGE_DOMAIN} {
	reverse_proxy storage:8080 {
		health_uri /healthz
	}
}

# The caddy Deployment probes /caddy-health on port 80, with the pod address
# as the host.
:80 {
	@caddy_health path /caddy-health
	handle @caddy_health {
		respond "OK" 200
	}

	handle {
		respond "Misdirected Request" 421
	}
}
