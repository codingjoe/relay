# Hidden files (dev/secrets/tooling) - exclude all, re-include if ever needed.
# .env.production ships with the production image, which decrypts it at start.
# A local build passes .env with DOTENV_FILE.
.*
!.env.production
!.env

# Python
venv/
env/
__pycache__/
*.py[codz]
*.pyo
*.egg-info/
*.egg
htmlcov/

# Node / frontend
node_modules/

# Django / runtime artifacts
staticfiles/
storage/
db.sqlite3
db.sqlite3-journal
*.log
root/static/css/app.css
root/locale/*.mo

# Test data and fixtures
fixtures/

# CI / tooling
justfile
*.just
conftest.py

# Deployment tooling - manifests, cluster scripts and the git-ignored
# deploy/.state with the Talos and kubeconfig secrets, none of which the
# image reads
deploy/

# Documentation (not needed in the image)
README.md
AGENTS.md
CLAUDE.md
REVIEW.md
CONVENTIONS.md
PRODUCT.md

# Misc
backups/
skills/
