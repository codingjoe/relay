{
  "dependencies": {
    "basecoat-css": "^1.0.2",
    "echarts": "^5.6.0",
    "lit": "^3.3.3",
    "lodash.escape": "^4.0.1",
    "lucide": "^1.50.0",
    "mermaid": "^11.17.2",
    "microlighter": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "cssnano": "^9.1.2",
    "esimport": "^0.10.1",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "wireit": "^0.14.0"
  },
  "imports": {
    "#abstract/*": "./abstract/static/abstract/*",
    "#js/*": "./root/static/js/*",
    "#message/*": "./services/email/message/static/message/*"
  },
  "name": "relay",
  "packageManager": "pnpm@11.20.0",
  "private": true,
  "scripts": {
    "build": "wireit",
    "dev": "wireit",
    "esm:build": "wireit",
    "esm:watch": "wireit"
  },
  "version": "0.1.0",
  "wireit": {
    "build": {
      "dependencies": [
        "css:build",
        "esm:build"
      ]
    },
    "css:build": {
      "command": "postcss src/css/app.css -o root/static/css/app.css",
      "files": [
        "src/css/**/*.css",
        "postcss.config.mjs",
        "pnpm-lock.yaml",
        "root/templates/**/*.html",
        "root/templates/**/*.svg",
        "services/**/*.html",
        "accounts/**/*.html",
        "domains/**/*.html",
        "abstract/**/*.html"
      ],
      "output": [
        "root/static/css/app.css"
      ]
    },
    "css:watch": {
      "command": "postcss src/css/app.css -o root/static/css/app.css --watch",
      "files": [
        "src/css/**/*.css",
        "postcss.config.mjs",
        "pnpm-lock.yaml"
      ],
      "service": true
    },
    "dev": {
      "dependencies": [
        "css:watch",
        "esm:watch"
      ]
    },
    "esm:build": {
      "command": "esimport . staticfiles/esm --treeshake",
      "files": [
        "package.json",
        "pnpm-lock.yaml",
        "abstract/static/**/*.js",
        "root/static/js/**/*.js",
        "services/email/message/static/**/*.js"
      ],
      "output": [
        "staticfiles/esm/**"
      ]
    },
    "esm:watch": {
      "command": "esimport . staticfiles/esm --treeshake --watch",
      "files": [
        "package.json",
        "pnpm-lock.yaml",
        "abstract/static/**/*.js",
        "root/static/js/**/*.js",
        "services/email/message/static/**/*.js"
      ],
      "service": true
    }
  }
}
